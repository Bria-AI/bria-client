{
  "$comment": "When the HTTP status is >= 400 and the body has no parseable 'error', SDKs synthesize a BriaError from the status code, reason phrase (fallback 'HTTP {code}'), and raw body text.",
  "cases": [
    {
      "name": "server_error_no_error_body",
      "statusCode": 500,
      "reasonPhrase": "Internal Server Error",
      "bodyText": "upstream exploded",
      "expectedError": {
        "code": 500,
        "message": "Internal Server Error",
        "details": "upstream exploded"
      }
    },
    {
      "name": "not_found_missing_reason",
      "statusCode": 404,
      "reasonPhrase": "",
      "bodyText": "",
      "expectedError": {
        "code": 404,
        "message": "HTTP 404",
        "details": ""
      }
    }
  ]
}
