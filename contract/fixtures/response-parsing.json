{
  "$comment": "Each case: a raw JSON body (as returned by the Bria API) and the BriaResponse fields both SDKs must derive from it. Status derivation: error->ERROR, else result->COMPLETED, else status_url->IN_PROGRESS, else UNKNOWN. An explicit 'status' in the body wins.",
  "cases": [
    {
      "name": "completed_when_result_present",
      "body": {
        "request_id": "req-completed-1",
        "result": { "image_url": "https://cdn.bria/out.png", "seed": 42 }
      },
      "expected": {
        "request_id": "req-completed-1",
        "status": "COMPLETED",
        "inProgress": false,
        "hasError": false,
        "hasResult": true
      }
    },
    {
      "name": "running_when_status_url_present",
      "body": {
        "request_id": "req-running-1",
        "status_url": "https://engine.prod.bria-api.com/v2/status/req-running-1"
      },
      "expected": {
        "request_id": "req-running-1",
        "status": "IN_PROGRESS",
        "inProgress": true,
        "hasError": false,
        "hasResult": false
      }
    },
    {
      "name": "failed_when_error_present",
      "body": {
        "request_id": "req-failed-1",
        "error": { "code": 422, "message": "Unprocessable Entity", "details": "bad prompt" }
      },
      "expected": {
        "request_id": "req-failed-1",
        "status": "ERROR",
        "inProgress": false,
        "hasError": true,
        "hasResult": false,
        "raiseForStatusThrows": true
      }
    },
    {
      "name": "unknown_when_empty",
      "body": { "request_id": "req-unknown-1" },
      "expected": {
        "request_id": "req-unknown-1",
        "status": "UNKNOWN",
        "inProgress": false,
        "hasError": false,
        "hasResult": false
      }
    },
    {
      "name": "explicit_status_wins",
      "body": {
        "request_id": "req-explicit-1",
        "status": "COMPLETED",
        "status_url": "https://engine.prod.bria-api.com/v2/status/req-explicit-1"
      },
      "expected": {
        "request_id": "req-explicit-1",
        "status": "COMPLETED",
        "inProgress": false,
        "hasError": false,
        "hasResult": false
      }
    }
  ]
}
