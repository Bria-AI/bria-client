{
  "$comment": "Deterministic HMAC-SHA256 webhook vectors. signing_key = HMAC(api_token, salt='bria-webhook-signing-v1'); message = '{webhook_id}.{timestamp}.{payload}'; expected = base64(HMAC(signing_key, message)). The signature header is a comma-separated list of 'v1=<base64>' tokens; verification passes if ANY token matches.",
  "cases": [
    {
      "name": "valid_single_token",
      "apiToken": "test-token-abc123",
      "webhookId": "req-9f8e7d6c",
      "timestamp": "1723800000",
      "payload": "{\"request_id\":\"req-9f8e7d6c\",\"status\":\"COMPLETED\"}",
      "signatureHeader": "v1=L49e/+aGg8Xr6F7PT9+bYWJ4ADPN73Pu5ooGltV5MUs=",
      "expected": true
    },
    {
      "name": "valid_among_multiple_tokens",
      "apiToken": "test-token-abc123",
      "webhookId": "req-9f8e7d6c",
      "timestamp": "1723800000",
      "payload": "{\"request_id\":\"req-9f8e7d6c\",\"status\":\"COMPLETED\"}",
      "signatureHeader": "v1=deadbeefWRONGdeadbeefWRONGdeadbeefWRONGdead=, v1=L49e/+aGg8Xr6F7PT9+bYWJ4ADPN73Pu5ooGltV5MUs=",
      "expected": true
    },
    {
      "name": "invalid_wrong_signature",
      "apiToken": "test-token-abc123",
      "webhookId": "req-9f8e7d6c",
      "timestamp": "1723800000",
      "payload": "{\"request_id\":\"req-9f8e7d6c\",\"status\":\"COMPLETED\"}",
      "signatureHeader": "v1=deadbeefWRONGdeadbeefWRONGdeadbeefWRONGdead=",
      "expected": false
    },
    {
      "name": "invalid_tampered_payload",
      "apiToken": "test-token-abc123",
      "webhookId": "req-9f8e7d6c",
      "timestamp": "1723800000",
      "payload": "{\"request_id\":\"req-9f8e7d6c\",\"status\":\"FAILED\"}",
      "signatureHeader": "v1=L49e/+aGg8Xr6F7PT9+bYWJ4ADPN73Pu5ooGltV5MUs=",
      "expected": false
    },
    {
      "name": "invalid_empty_header",
      "apiToken": "test-token-abc123",
      "webhookId": "req-9f8e7d6c",
      "timestamp": "1723800000",
      "payload": "{\"request_id\":\"req-9f8e7d6c\",\"status\":\"COMPLETED\"}",
      "signatureHeader": "",
      "expected": false
    }
  ]
}
